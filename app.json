{
  "expo": {
    "name": "Solid Connect",
    "slug": "solid-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "solidconnect",
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#3459d4"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Solid Connect uses your location to suggest your neighborhood, and shares it with your provider or customer only while a job is active."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Solid Connect needs access to your photos so you can attach pictures to requests, your portfolio and verification documents.",
          "cameraPermission": "Solid Connect uses your camera so you can take photos for requests, your portfolio and verification documents."
        }
      ],
      "expo-video",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "Solid Connect uses your microphone so you can record and send voice notes in chat.",
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Solid Connect can use Face ID to unlock the app instead of typing your password every time.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.solidconnect.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.solidconnect.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "description": "Find and book trusted local service providers in Ghana.",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "71928ae5-a56b-4fbf-8971-f28898e0c185"
      }
    },
    "owner": "plndominic"
  }
}
