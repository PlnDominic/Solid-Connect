# NestJS API
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1

# Supabase (same project as mobile/admin)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Redis
REDIS_URL=redis://127.0.0.1:6379

# CORS (comma-separated origins). Empty = any origin in development, NO browser
# origin in production. The mobile app is not affected (native apps skip CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Production (NODE_ENV=production) -------------------------------------
# The API refuses to start in production unless Supabase is configured, the
# Hubtel settings below are set (or ALLOW_SIMULATED_PAYMENTS=true), and
# CORS_ORIGINS has no "*".
#
# How many proxies sit in front of the API (a load balancer, platform router).
# Needed so rate limiting counts each user separately rather than the proxy.
# Defaults to 1 in production and off in development. Never "true".
# TRUST_PROXY=1
#
# Serve the interactive API docs at /docs. On by default outside production.
# ENABLE_SWAGGER=false
#
# Staging only: run production mode without Hubtel, so "confirm completion"
# releases money with nothing charged. NEVER set this on the live API.
# ALLOW_SIMULATED_PAYMENTS=false

# Optional Expo access token. Pushes still send without it; set this in production
# so Expo can reject unauthorized senders. Delivery is FCM on Android and APNs on iOS.
EXPO_ACCESS_TOKEN=

# Hubtel (Phase G). Leave blank in development to keep simulated release-on-confirm.
# Required in production.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
# Optional prepaid deposit account for Send Money. Defaults to the merchant account.
HUBTEL_PREPAID_ACCOUNT=
# Public URL Hubtel can POST, e.g. https://api.example.com/api/v1/payments/webhooks/hubtel
HUBTEL_CALLBACK_URL=
# Where the customer browser returns after checkout (app deep link is fine).
HUBTEL_RETURN_URL=solidconnect://payment-return
