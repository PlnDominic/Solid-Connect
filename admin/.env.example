NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Public URL of this admin app, used in invite / setup-link emails.
# Optional - derived from the request when unset.
ADMIN_SITE_URL=https://admin.example.com

# Public /legal pages (Terms, Privacy, Refunds, Provider Agreement) return
# 404 until this is "true". Only set it once counsel has approved
# docs/legal - see docs/legal/README.md.
LEGAL_PAGES_PUBLISHED=false
