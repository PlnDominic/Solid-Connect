# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Nest API. On a physical phone, localhost is rewritten to the Metro LAN host automatically.
# Keep localhost for simulators; override with http://YOUR_LAN_IP:3001 only if rewrite fails.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional aliases (same project)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Migrations need a Postgres URL (Dashboard → Project Settings → Database):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
